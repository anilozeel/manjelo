# Manjelo Burger — Apache (cPanel) ayarları

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# http:// ve www. adresleri https://manjeloburger.com adresine yönlendir
# (AutoSSL sertifika doğrulaması için /.well-known/ hariç)
# (önde bir proxy varsa X-Forwarded-Proto'ya bakılır; sonsuz döngüyü önler)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://manjeloburger.com%{REQUEST_URI} [L,R=301]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://manjeloburger.com%{REQUEST_URI} [L,R=301]

# Adreslerde .html görünmesin
# /index.html  ->  /
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://manjeloburger.com/$1 [R=301,L]
# /sayfa.html  ->  /sayfa
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ https://manjeloburger.com/%1 [R=301,L]
# /sayfa  ->  sayfa.html dosyasını göster
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
